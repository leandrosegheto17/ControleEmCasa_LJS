{
  "name": "@controle/scripts",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrar": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migracoes --database-url-var DATABASE_URL_OWNER --no-single-transaction",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "purgar": "tsx --env-file-if-exists=../../.env src/purgar.ts",
    "gerar-vapid": "tsx src/gerar-vapid.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "massa": "tsx --env-file-if-exists=../../.env src/massa-dois-anos.ts",
    "medir-cpu": "tsx src/medir-cpu.ts",
    "conferir-banco": "tsx --env-file-if-exists=../../.env src/operacao/conferir-banco.ts",
    "medir-cpu-publicado": "tsx src/operacao/medir-cpu-publicado.ts",
    "cache-hyperdrive": "tsx src/operacao/cache-hyperdrive.ts",
    "restauracao-neon": "tsx src/operacao/restauracao-neon.ts",
    "dump-cifrado": "tsx src/operacao/dump-cifrado.ts",
    "migracoes-aditivas": "tsx src/operacao/migracao-aditiva.ts"
  },
  "dependencies": {
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0"
  }
}
